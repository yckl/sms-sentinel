<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#49A6FF"
                android:centerColor="#0A84FF"
                android:endColor="#0062CC" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="top|end"
        android:top="-34dp"
        android:right="-38dp">
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>
    <item
        android:width="170dp"
        android:height="170dp"
        android:gravity="bottom|start"
        android:bottom="-70dp"
        android:left="-60dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
